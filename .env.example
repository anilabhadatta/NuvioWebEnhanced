# NuvioWebEnhanced Environment Variables Template

# Supabase Configurations (Fallbacks are set in code if not specified)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Metadata APIs & TMDB Key (Fallback key configured in code)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
NEXT_PUBLIC_PARENTAL_GUIDE_API_URL=https://api.imdbapi.dev/
NEXT_PUBLIC_IMDB_RATINGS_API_BASE_URL=https://seriesgraph.com/
NEXT_PUBLIC_INTRODB_API_URL=https://api.introdb.app

# Trakt Integration (Required for scrobbling and syncing watch history)
NEXT_PUBLIC_TRAKT_CLIENT_ID=your_trakt_client_id
NEXT_PUBLIC_TRAKT_CLIENT_SECRET=your_trakt_client_secret
NEXT_PUBLIC_TRAKT_API_URL=https://api.trakt.tv
NEXT_PUBLIC_TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Custom Links & Redirects
NEXT_PUBLIC_TV_LOGIN_REDIRECT_BASE_URL=https://your-app.com/tv-login
NEXT_PUBLIC_YOUTUBE_PROXY_URL=https://nuviomedia.github.io/NuvioWeb/youtube-proxy.html
NEXT_PUBLIC_AVATAR_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/avatars
NEXT_PUBLIC_CONTRIBUTIONS_URL=
NEXT_PUBLIC_DONATIONS_BASE_URL=
NEXT_PUBLIC_DONATIONS_DONATE_URL=

# Stream proxy feature flag (set to false to completely disable /api/streamProxy)
NEXT_PUBLIC_STREAM_PROXY=true
